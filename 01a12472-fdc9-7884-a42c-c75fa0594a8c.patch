index 0000000..747da34
--- /dev/null
+++ b/survey_flow/instructions.py
@@ -0,0 +1,363 @@
+"""Red/bold instruction detection and parsing (rule-based, no AI).
+
+Two responsibilities:
+  1. detect_red_bold()  - is this element a red (optionally bold) instruction?
+  2. parse_instruction() - turn instruction text into an answer hint, then
+     match the hint against the question's actual options.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from difflib import SequenceMatcher
+from typing import Optional
+
+# --------------------------------------------------------------------------- #
+# label helpers
+# --------------------------------------------------------------------------- #
+
+_PUNCT_RE = re.compile(r"[^\w\s%$€£+/&.'-]", re.UNICODE)
+_WS_RE = re.compile(r"\s+")
+
+
+def norm_label(s: str) -> str:
+    """Normalize a label for fuzzy comparison."""
+    s = unicodedata.normalize("NFKC", s or "")
+    s = s.casefold()
+    s = s.replace("'", "").replace("\u2019", "")   # don't -> dont
+    s = _PUNCT_RE.sub(" ", s)
+    s = _WS_RE.sub(" ", s).strip()
+    return s
+
+
+def _phrase_in(haystack: str, needle: str) -> bool:
+    """Word-boundary phrase containment on normalized strings."""
+    if not haystack or not needle:
+        return False
+    return re.search(r"(?<!\w)" + re.escape(needle) + r"(?!\w)", haystack) is not None
+
+
+# special answer options -----------------------------------------------------
+EXCLUSIVE_RE = re.compile(
+    r"(none\s+of\s+(these|them|those|the\s+above)|"
+    r"do\s+n[o']t\s+know|don'?t\s+know|dont\s+know|"
+    r"not\s+sure|no\s+opinion|no\s+answer|no\s+response|"
+    r"not\s+applicable|n/?a\b|"
+    r"prefer\s+not\s+to\s+(answer|say|disclose|state|tell)|"
+    r"rather\s+not\s+(answer|say)|refus(?:e|ed|al)|"
+    r"i\s+have\s+not\s+(used|seen|purchased|heard)|"
+    r"have\s+n[o']t\s+used|nothing|neither)",
+    re.I,
+)
+
+OTHER_RE = re.compile(r"^(other|none of these above|other\s*\(.*\)|.*\bspecify\b.*|other[:.\s-].*)$", re.I)
+
+CONSENT_RE = re.compile(
+    r"\b(i\s+(agree|consent)|agree\s+to|consent|accept(s|ed)?\s+(the\s+)?(terms|policy)|"
+    r"yes[,\s-]+i\s+(agree|accept))\b",
+    re.I,
+)
+
+# validation messages must never be treated as answer instructions
+VALIDATIONISH_RE = re.compile(
+    r"(please\s+(answer|enter|select|provide|choose|fill|specify|type|check)|"
+    r"is\s+required|invalid|at\s+least\s+\d+|too\s+(long|short)|must\s+be|"
+    r"out\s+of\s+range|no\s+answer\s+(selected|given))",
+    re.I,
+)
+
+PLACEHOLDER_OPTION_RE = re.compile(
+    r"^(\s*-{2,}\s*.*|select\s+(one|an?\s+option|please).*|please\s+select.*|"
+    r"choose\s+.*|\[.*\]|--.*)$",
+    re.I,
+)
+
+
+# --------------------------------------------------------------------------- #
+# red / bold detection (works off inline styles, font tags, classes - no JS)
+# --------------------------------------------------------------------------- #
+
+_COLOR_NAMES = {
+    "red": (255, 0, 0),
+    "crimson": (220, 20, 60),
+    "firebrick": (178, 34, 34),
+    "darkred": (139, 0, 0),
+    "tomato": (255, 99, 71),
+    "indianred": (205, 92, 92),
+}
+
+
+def _parse_color(value: str) -> Optional[tuple[int, int, int]]:
+    value = (value or "").strip().lower()
+    if not value:
+        return None
+    if value in _COLOR_NAMES:
+        return _COLOR_NAMES[value]
+    if value.startswith("#"):
+        h = value[1:]
+        if len(h) == 3:
+            h = "".join(c * 2 for c in h)
+        if len(h) == 6:
+            try:
+                return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
+            except ValueError:
+                return None
+    m = re.match(r"rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})", value)
+    if m:
+        return int(m.group(1)), int(m.group(2)), int(m.group(3))
+    return None
+
+
+def _is_red(rgb: tuple[int, int, int]) -> bool:
+    r, g, b = rgb
+    return r >= 150 and g <= 100 and b <= 100 and (r - max(g, b)) >= 70
+
+
+def _style_of(tag) -> str:
+    return (tag.get("style") or "").replace(" ", "").lower()
+
+
+def _color_from_style(style: str) -> Optional[tuple[int, int, int]]:
+    m = re.search(r"(?:^|;)color:([^;]+)", style)
+    if m:
+        return _parse_color(m.group(1))
+    return None
+
+
+def _bold_from_style(style: str) -> bool:
+    m = re.search(r"(?:^|;)font-weight:([^;]+)", style)
+    if not m:
+        return False
+    v = m.group(1).strip().lower()
+    if v in ("bold", "bolder"):
+        return True
+    try:
+        return int(v) >= 600
+    except ValueError:
+        return False
+
+
+def element_color_bold(tag, stop_tag=None) -> tuple[bool, bool]:
+    """Walk `tag` and its ancestors (up to stop_tag) for red & bold signals.
+
+    Returns (is_red, is_bold).  A `<span style="color:red"><b>text</b></span>`
+    is red (from the span) and bold (from the inner b) - handled by checking
+    the full ancestor chain of the *text* element.
+    """
+    red = bold = False
+    node = tag
+    depth = 0
+    while node is not None and node is not getattr(stop_tag, "name", None) and depth < 6:
+        name = getattr(node, "name", None)
+        style = _style_of(node) if hasattr(node, "get") else ""
+        color = _color_from_style(style)
+        if color and _is_red(color):
+            red = True
+        if name in ("b", "strong") or _bold_from_style(style):
+            bold = True
+        # <font color="red">
+        if name == "font" and _parse_color(node.get("color") or "") is not None:
+            if _is_red(_parse_color(node.get("color") or "")):
+                red = True
+        # class tokens
+        classes = " ".join(node.get("class") or []) if hasattr(node, "get") else ""
+        lowc = classes.lower()
+        if "red" in lowc and ("bold" in lowc or "instruction" in lowc):
+            red = True
+        if "bold" in lowc:
+            bold = True
+        parent = getattr(node, "parent", None)
+        node = parent
+        depth += 1
+        if stop_tag is not None and node is stop_tag:
+            break
+    return red, bold
+
+
+def detect_red_bold(tag, stop_tag=None) -> tuple[bool, bool]:
+    """Is this element itself a red/bold instruction carrier?
+
+    Checks the element's own text (not deep children) so nested markup like
+    `<span style="color:#f00"><b>text</b></span>` reports red+bold when asked
+    about the span, and red+bold when asked about the b (via ancestors).
+    """
+    return element_color_bold(tag, stop_tag)
+
+
+# --------------------------------------------------------------------------- #
+# instruction parsing
+# --------------------------------------------------------------------------- #
+
+@dataclass
+class Hint:
+    kind: str = "options"             # options | text | number | none
+    targets: list[str] = field(default_factory=list)
+    numbers: list[float] = field(default_factory=list)
+    raw: str = ""
+
+
+_QUOTE_RE = re.compile(r"""['"“”„`]\s*([^'"“”„`]{1,80}?)\s*['"“”„`]""")
+_VERB_RE = re.compile(
+    r"\b(?:select|choose|pick|click(?:\s+on)?|answer|mark|tap|opt\s+for|go\s+with|"
+    r"enter|type|input|fill\s+in|write|set)\b",
+    re.I,
+)
+_VERB_TAIL_RE = re.compile(
+    r"\b(?:(?:select|choose|pick|click(?:\s+on)?|answer|mark|tap|opt\s+for|go\s+with|"
+    r"enter(?:\s+a\s+number|\s+an?\s+age)?|type|input|fill\s+in|write|set)\b)"
+    r"(?:\s+(?:the|an?\s+one|exactly\s+one|one|all|each|only))?"
+    r"\s*(?:option|answer|button|response|value|choice|item)?\s*"
+    r"(?:[:\-\u2013\u2014]\s*|\s+)?(.+?)(?:[.!?,;]|$)",
+    re.I,
+)
+_COLON_SPLIT_RE = re.compile(r"[:\u2013\u2014]\s*")
+_PART_SPLIT_RE = re.compile(r"\s*(?:,|;|\band\b|\bor\b|&|\balso\b)\s*", re.I)
+_NUMBER_RE = re.compile(r"^-?\d+(?:\.\d+)?$")
+
+# verbs that mean "type text" rather than "pick an option"
+_TEXT_VERBS_RE = re.compile(r"\b(enter|type|input|write|fill\s+in)\b", re.I)
+# phrases that are guidance, not an answer target
+_GUIDANCE_RE = re.compile(
+    r"\b(avoid|do\s+n[o']t|don'?t|never|make\s+sure|remember|be\s+sure|"
+    r"answer\s+(honestly|truthfully)|pick\s+(one|any)\b)",
+    re.I,
+)
+
+
+def parse_instruction(text: str) -> Hint:
+    """Turn an instruction sentence into a Hint (targets to match against options)."""
+    raw = " ".join((text or "").split())
+    if not raw:
+        return Hint(kind="none")
+
+    hint = Hint(raw=raw)
+
+    # explicit text entry:  enter: "some text"  /  type: abc
+    if _TEXT_VERBS_RE.search(raw) and _COLON_SPLIT_RE.search(raw):
+        after = _COLON_SPLIT_RE.split(raw, 1)[1].strip()
+        after = after.strip("'\"“”")
+        if after:
+            hint.kind = "text"
+            hint.targets = [after]
+            return hint
+
+    candidates: list[str] = []
+    quoted = [q.strip() for q in _QUOTE_RE.findall(raw)]
+    candidates.extend(quoted)
+
+    parts = _COLON_SPLIT_RE.split(raw, 1)
+    if len(parts) == 2 and parts[1].strip():
+        candidates.append(parts[1].strip())
+
+    m = _VERB_TAIL_RE.search(raw)
+    if m and m.group(1):
+        candidates.append(m.group(1).strip())
+
+    # whole string if short and looks like an answer, not guidance
+    if not candidates and len(raw) <= 60 and not _GUIDANCE_RE.search(raw) and not _VERB_RE.search(raw):
+        candidates.append(raw)
+
+    # expand multi-targets
+    expanded: list[str] = []
+    for c in candidates:
+        c = c.strip(" .;:!?")
+        for piece in _PART_SPLIT_RE.split(c):
+            piece = piece.strip(" .;:!?'\"“”")
+            if piece:
+                expanded.append(piece)
+
+    # numbers present?
+    for piece in expanded:
+        if _NUMBER_RE.match(piece):
+            try:
+                hint.numbers.append(float(piece))
+            except ValueError:
+                pass
+
+    hint.targets = expanded
+    if not expanded and hint.numbers:
+        hint.kind = "number"
+    elif expanded:
+        hint.kind = "options"
+    else:
+        hint.kind = "none"
+    return hint
+
+
+def match_targets_to_options(targets: list[str], numbers: list[float],
+                             option_fields: list, question_kind: str) -> list:
+    """Return the option fields matched by hint targets/numbers.
+
+    Matching: exact normalized > substring (either way) > fuzzy ratio >= 0.80.
+    Numbers match an option whose label equals the number, or its position
+    (1-based) for ordinal scales / NPS.
+    """
+    matched: list = []
+    seen: set[int] = set()
+
+    def add(f) -> None:
+        if id(f) not in seen:
+            seen.add(id(f))
+            matched.append(f)
+
+    # normalize option labels once
+    opts = [(f, norm_label(f.label or f.value)) for f in option_fields]
+
+    for t in targets:
+        nt = norm_label(t)
+        if not nt:
+            continue
+        # exact
+        exact = [f for f, no in opts if no == nt]
+        if exact:
+            for f in exact:
+                add(f)
+            continue
+        # phrase containment either way (word-boundary: "male" must NOT
+        # match inside "female")
+        subs = [f for f, no in opts
+                if len(nt) >= 3 and (_phrase_in(no, nt) or (len(no) >= 3 and _phrase_in(nt, no)))]
+        if subs:
+            for f in subs[:4]:
+                add(f)
+            continue
+        # fuzzy (strict: "male"/"female" scores exactly 0.8)
+        best, best_ratio = None, 0.0
+        for f, no in opts:
+            r = SequenceMatcher(None, nt, no).ratio()
+            if r > best_ratio:
+                best, best_ratio = f, r
+        if best is not None and best_ratio >= 0.86:
+            add(best)
+
+    # numeric targets: label equals number, or 1-based position (NPS/ordinal)
+    for n in hintless_number_iter(numbers):
+        want = str(int(n)) if float(n).is_integer() else str(n)
+        label_hits = [f for f, no in opts if no == norm_label(want)]
+        if label_hits:
+            for f in label_hits:
+                add(f)
+            continue
+        idx = int(n) if n >= 0 else -1
+        if question_kind in ("single", "grid_single", "nps", "rating", "ranking", "dropdown") \
+                and 1 <= idx <= len(opts):
+            add(opts[idx - 1][0])
+
+    return matched
+
+
+def hintless_number_iter(numbers: list[float]):
+    return numbers
+
+
+def labels_match(a: str, b: str) -> bool:
+    na, nb = norm_label(a), norm_label(b)
+    if not na or not nb:
+        return False
+    if na == nb:
+        return True
+    if len(na) >= 3 and (_phrase_in(nb, na) or _phrase_in(na, nb)):
+        return True
+    return SequenceMatcher(None, na, nb).ratio() >= 0.86
diff --git a/survey_flow/memory.py b/survey_flow/memory.py
new file mode 100644
index 0000000..3b742a2
--- /dev/null
+++ b/survey_flow/memory.py
@@ -0,0 +1,220 @@
+"""Persistent memory of selections that ended a run (terminate / quota-full).
+
+Stored as JSON so learning survives restarts.  Questions are identified by a
+stable signature, options by their normalized label (option order can be
+randomized between sessions, labels cannot).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from .instructions import norm_label
+
+DEFAULT_MEMORY_PATH = "survey_memory.json"
+# statuses whose selections should be avoided on future runs
+AVOIDABLE = ("terminate", "quota_full")
+
+
+@dataclass
+class QuestionMemory:
+    text: str = ""
+    seen: int = 0
+    ends: dict = field(default_factory=dict)   # option identity -> record
+
+
+class TerminateMemory:
+    def __init__(self, path: str = DEFAULT_MEMORY_PATH, avoid: tuple[str, ...] = AVOIDABLE):
+        self.path = Path(path)
+        self.avoid = tuple(avoid)
+        self.data: dict = {"version": 1, "questions": {}, "stats": self._new_stats()}
+        self.load()
+
+    # ------------------------------------------------------------------ #
+    @staticmethod
+    def _new_stats() -> dict:
+        return {
+            "runs": 0,
+            "completes": 0,
+            "terminates": 0,
+            "quota_full": 0,
+            "validations": 0,
+            "stuck": 0,
+            "last_run": None,
+        }
+
+    def load(self) -> None:
+        if self.path.exists():
+            try:
+                loaded = json.loads(self.path.read_text(encoding="utf-8"))
+                if isinstance(loaded, dict) and "questions" in loaded:
+                    self.data = loaded
+                    self.data.setdefault("stats", self._new_stats())
+            except (json.JSONDecodeError, OSError):
+                # keep a corrupt file aside instead of losing it
+                try:
+                    self.path.replace(self.path.with_suffix(".corrupt.json"))
+                except OSError:
+                    pass
+                self.data = {"version": 1, "questions": {}, "stats": self._new_stats()}
+
+    def save(self) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        payload = json.dumps(self.data, indent=2, ensure_ascii=False)
+        # atomic write
+        fd, tmp = tempfile.mkstemp(dir=str(self.path.parent), suffix=".tmp")
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as fh:
+                fh.write(payload)
+            os.replace(tmp, self.path)
+        finally:
+            if os.path.exists(tmp):
+                try:
+                    os.remove(tmp)
+                except OSError:
+                    pass
+
+    # ------------------------------------------------------------------ #
+    def note_seen(self, sig: str, text: str = "") -> None:
+        q = self.data["questions"].setdefault(sig, {"text": text, "seen": 0, "ends": {}})
+        if text and not q.get("text"):
+            q["text"] = text
+        q["seen"] = int(q.get("seen", 0)) + 1
+
+    def mark_end(
+        self,
+        sig: str,
+        text: str,
+        chosen: list[dict],
+        status: str,
+        *,
+        url: str = "",
+        message: str = "",
+    ) -> list[str]:
+        """Record the choices that coincided with a run-ending status.
+
+        `chosen` is a list of {"label": ..., "value": ..., "identity": ...}.
+        Returns the identities recorded.
+        """
+        q = self.data["questions"].setdefault(sig, {"text": text, "seen": 0, "ends": {}})
+        if text:
+            q["text"] = text
+        recorded = []
+        for c in chosen:
+            ident = c.get("identity")
+            if not ident:
+                if c.get("label"):
+                    ident = "l:" + norm_label(c["label"])
+                elif c.get("value"):
+                    ident = "v:" + c["value"]
+                else:
+                    continue
+            rec = q["ends"].setdefault(ident, {
+                "label": c.get("label", ""),
+                "value": c.get("value", ""),
+                "count": 0,
+                "statuses": {},
+            })
+            rec["count"] = int(rec.get("count", 0)) + 1
+            sts = rec.setdefault("statuses", {})
+            sts[status] = int(sts.get(status, 0)) + 1
+            rec["last_status"] = status
+            rec["last_url"] = url
+            rec["last_message"] = message[:300]
+            rec["last_ts"] = time.strftime("%Y-%m-%dT%H:%M:%S")
+            recorded.append(ident)
+        stat_key = "terminates" if status == "terminate" else status
+        stats = self.data.setdefault("stats", self._new_stats())
+        stats[stat_key] = int(stats.get(stat_key, 0)) + 1
+        return recorded
+
+    # ------------------------------------------------------------------ #
+    def is_fatal(self, sig: str, identity: str, label: str = "", value: str = "") -> bool:
+        """Should future runs avoid this option for this question?"""
+        q = self.data["questions"].get(sig)
+        if not q:
+            return False
+        ends = q.get("ends", {})
+        keys = [identity]
+        if label:
+            keys.append("l:" + norm_label(label))
+        if value:
+            keys.append("v:" + value)
+        for k in keys:
+            if k in ends:
+                rec = ends[k]
+                statuses = rec.get("statuses") or {}
+                status = rec.get("last_status")
+                if any(s in self.avoid for s in statuses) or (status in self.avoid):
+                    return True
+        return False
+
+    def fatal_options(self, sig: str) -> dict:
+        """identity -> record, restricted to avoid-worthy statuses."""
+        q = self.data["questions"].get(sig)
+        if not q:
+            return {}
+        out = {}
+        for ident, rec in q.get("ends", {}).items():
+            statuses = rec.get("statuses") or {}
+            status = rec.get("last_status")
+            if any(s in self.avoid for s in statuses) or (status in self.avoid):
+                out[ident] = rec
+        return out
+
+    def all_fatal(self, sig: str) -> bool:
+        """True when at least one avoidable end exists (per-question flag)."""
+        return bool(self.fatal_options(sig))
+
+    # ------------------------------------------------------------------ #
+    def set_learned(self, sig: str, key: str, value) -> None:
+        """Persist a lesson from a validation message (e.g. min_select=4)."""
+        q = self.data["questions"].setdefault(sig, {"text": "", "seen": 0, "ends": {}})
+        learned = q.setdefault("learned", {})
+        learned[key] = value
+
+    def learned(self, sig: str, key: str, default=None):
+        q = self.data["questions"].get(sig) or {}
+        return (q.get("learned") or {}).get(key, default)
+
+    # ------------------------------------------------------------------ #
+    def bump(self, key: str, n: int = 1) -> None:
+        stats = self.data.setdefault("stats", self._new_stats())
+        stats[key] = int(stats.get(key, 0)) + n
+
+    @property
+    def stats(self) -> dict:
+        return self.data.setdefault("stats", self._new_stats())
+
+    def summary_lines(self) -> list[str]:
+        lines = []
+        s = self.stats
+        lines.append(
+            f"runs={s.get('runs', 0)} completes={s.get('completes', 0)} "
+            f"terminates={s.get('terminates', 0)} quota_full={s.get('quota_full', 0)} "
+            f"validations={s.get('validations', 0)} stuck={s.get('stuck', 0)}"
+        )
+        qs = self.data.get("questions", {})
+        if not qs:
+            lines.append("no remembered terminate selections yet")
+            return lines
+        lines.append(f"{len(qs)} question(s) with remembered end selections:")
+        for sig, q in qs.items():
+            fatal = self.fatal_options(sig)
+            if not fatal:
+                continue
+            text = (q.get("text") or sig)[:70]
+            labels = ", ".join(
+                (r.get("label") or r.get("value") or ident)
+                for ident, r in fatal.items()
+            )
+            lines.append(f"  [{sig}] {text!r} -> avoid: {labels}")
+        return lines
+
+    def clear(self) -> None:
+        self.data = {"version": 1, "questions": {}, "stats": self._new_stats()}
+        self.save()
diff --git a/survey_flow/models.py b/survey_flow/models.py
new file mode 100644
index 0000000..6445951
--- /dev/null
+++ b/survey_flow/models.py
@@ -0,0 +1,166 @@
+"""Data models shared across analyzer, decider, engines and runner."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Optional
+
+
+class Outcome(str, Enum):
+    """Classification of the page the tool is currently on."""
+
+    QUESTION = "question"
+    INTERSTITIAL = "interstitial"      # start / continue-only page
+    VALIDATION = "validation"          # question page carrying validation errors
+    COMPLETE = "complete"
+    TERMINATE = "terminate"
+    QUOTA_FULL = "quota_full"
+    UNKNOWN = "unknown"
+
+
+@dataclass
+class Field:
+    """A single form control, in DOM order."""
+
+    dom_index: int                    # index among input/select/textarea tags
+    name: str
+    type: str                         # radio|checkbox|select-one|select-multiple|text|
+                                      # textarea|number|range|date|time|hidden|submit|...
+    label: str = ""
+    value: str = ""                   # current/original value (options: their value)
+    checked: bool = False             # original checked state
+    row_label: str = ""               # for grids: the row header text
+    min: Optional[str] = None
+    max: Optional[str] = None
+    step: Optional[str] = None
+    maxlength: Optional[int] = None
+    minlength: Optional[int] = None
+    placeholder: Optional[str] = None
+    pattern: Optional[str] = None
+    required: bool = False
+    exclusive: bool = False           # "None of these", "Don't know", ...
+    consent: bool = False             # consent/agree checkbox
+    is_placeholder_option: bool = False  # "-- Select --" style dropdown option
+    options: list["Field"] = field(default_factory=list)  # for selects: their options
+    # decision output ------------------------------------------------------
+    selected: bool = False            # checkbox/radio: should be selected
+    new_value: Optional[str] = None   # scalar/select: value to send
+
+    @property
+    def identity(self) -> str:
+        """Stable identity used by the terminate-memory."""
+        from .instructions import norm_label
+
+        if self.label:
+            return "l:" + norm_label(self.label)
+        if self.value:
+            return "v:" + self.value
+        return "n:" + self.name
+
+    def chosen_identity(self) -> Optional[str]:
+        """Identity of this field's chosen answer (None when not chosen)."""
+        if self.type in ("radio", "checkbox"):
+            return self.identity if self.selected else None
+        if self.type == "select-one" and self.new_value is not None:
+            opt = next((o for o in self.options if o.value == self.new_value), None)
+            if opt is not None:
+                return opt.identity
+            return "v:" + self.new_value
+        if self.type == "select-multiple":
+            return None
+        return None
+
+    @property
+    def chosen_option(self) -> Optional["Field"]:
+        """For a select: the option Field that was chosen."""
+        if self.type != "select-one" or self.new_value is None:
+            return None
+        return next((o for o in self.options if o.value == self.new_value), None)
+
+
+@dataclass
+class Question:
+    """One question (cluster of fields) on the current page."""
+
+    sig: str                          # stable signature (container id / name base / text hash)
+    text: str
+    kind: str                         # single|multi|dropdown|text|number|slider|date|time|
+                                      # grid_single|grid_multi|ranking|constant_sum|unknown
+    fields: list[Field] = field(default_factory=list)
+    instructions: list[str] = field(default_factory=list)   # red(-and-bold) instruction texts
+    notes: list[str] = field(default_factory=list)          # plain instruction texts
+    qid: str = ""
+    min_select: int = 1
+    max_select: Optional[int] = None
+    total: Optional[int] = None       # constant-sum total
+    validation: list[str] = field(default_factory=list)     # validation messages for this page
+
+    @property
+    def is_choice(self) -> bool:
+        return self.kind in (
+            "single", "multi", "dropdown", "grid_single",
+            "grid_multi", "ranking", "rating", "nps",
+        )
+
+    @property
+    def choices(self) -> list[Field]:
+        return [f for f in self.fields if f.type in ("radio", "checkbox")
+                or f.type in ("select-one", "select-multiple")]
+
+    @property
+    def scalars(self) -> list[Field]:
+        return [f for f in self.fields if f.type in
+                ("text", "textarea", "number", "range", "date", "time", "datetime-local")]
+
+    @property
+    def chosen_options(self) -> list[Field]:
+        """The option-level fields actually chosen (selects resolve to their option)."""
+        out: list[Field] = []
+        for f in self.fields:
+            if f.type in ("radio", "checkbox") and f.selected:
+                out.append(f)
+            elif f.type == "select-one" and f.new_value is not None:
+                opt = f.chosen_option
+                out.append(opt if opt is not None else f)
+        return out
+
+    @property
+    def value_texts(self) -> list[str]:
+        """Human-readable descriptions of what was chosen."""
+        out = []
+        for f in self.chosen_options:
+            out.append(f.label or f.new_value or f.value)
+        for f in self.scalars:
+            if f.new_value not in (None, ""):
+                out.append(f"{f.label or f.name}={f.new_value}")
+        return out
+
+
+@dataclass
+class SubmitControl:
+    name: str
+    value: str
+    label: str
+    dom_index: int
+    tag: str = "input"                # input|button
+
+
+@dataclass
+class Page:
+    """Fully analyzed page."""
+
+    url: str
+    outcome: Outcome
+    questions: list[Question] = field(default_factory=list)
+    messages: list[str] = field(default_factory=list)     # end-status / validation messages
+    hiddens: list[tuple[str, str]] = field(default_factory=list)
+    submits: list[SubmitControl] = field(default_factory=list)
+    form_action: str = ""
+    form_method: str = "POST"
+    js_heavy: bool = False            # page looks JS-driven (no classic form)
+
+    @property
+    def signature(self) -> str:
+        """Cheap identity of this page state, used for stall detection."""
+        return "|".join(q.sig for q in self.questions) or f"{self.outcome.value}:{self.url}"
diff --git a/survey_flow/outcomes.py b/survey_flow/outcomes.py
new file mode 100644
index 0000000..cc63e5d
--- /dev/null
+++ b/survey_flow/outcomes.py
@@ -0,0 +1,143 @@
+"""Classify a page: question / validation / interstitial / complete / terminate / quota-full.
+
+Pure text heuristics — no AI.  Detection order matters: an end page often still
+says "Thank you", so terminate and quota signals are checked first.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+QUOTA_PATTERNS = [
+    re.compile(r"quota[^\n]{0,40}(full|reached|limit|exceeded|already\s*(been\s*)?filled)"),
+    re.compile(r"(over|over[- ])?quota[- ]full"),
+    re.compile(r"you\s+(have\s+)?(been\s+)?over\s*quota"),
+    re.compile(r"the\s+quota\s+(for|cell)[^\n]{0,60}(full|reached)"),
+    re.compile(r"too\s+many\s+(respondents|participants|answers|completions)"),
+    re.compile(r"quota-?full|overquota"),
+]
+
+TERMINATE_PATTERNS = [
+    # end-page phrasings (context required so question text like
+    # "Have you ever been terminated?" never matches)
+    re.compile(r"\b(survey|interview|session|screening|screen|respondent)[^\n]{0,40}terminat"),
+    re.compile(r"\byou\s+have\s+been\s+terminat"),
+    re.compile(r"\byou\s+(?:are|were|will\s+be)\s+terminat"),
+    re.compile(r"\bwe\s+(?:must|have\s+to|need\s+to)\s+terminat"),
+    re.compile(r"\bterminat(?:e|ed|ion)\s+(?:page|screen|status|message|point|here|now)"),
+    re.compile(r"\bdisqualifi(?:ed|cation)\b"),
+    re.compile(r"\bscreened\s+out\b"),
+    re.compile(r"\byou\s+(?:are|were|have\s+been)\s+not\s+qualifi"),
+    re.compile(r"\bnot\s+qualifi(?:ed|er)\b"),
+    re.compile(r"\bdo(?:es)?\s+not\s+qualify\b"),
+    re.compile(r"\b(do|does|did)\s+n[o']t\s+qualify\b"),
+    re.compile(r"\bdoes\s+not\s+(meet|match)[^\n]{0,40}(criteria|requirements)"),
+    re.compile(r"\bunfortunately[^\n]{0,120}\b(qualify|selected|invited|participat)"),
+    re.compile(r"\bnot\s+(eligible|eligible\s+for|invited)\b"),
+    re.compile(r"\bno\s+longer\s+(eligible|needed|required)\b"),
+    re.compile(r"\bthank\s+you\s+for\s+your\s+interest[^\n]{0,80}(unable|cannot|unable to)"),
+    re.compile(r"\bwe\s+(are\s+)?unable\s+to\s+(include|proceed|invite)[^\n]{0,60}"),
+    re.compile(r"/terminates?\b"),
+    re.compile(r"[?&/]term(inate)?[=/&]"),
+]
+
+COMPLETE_PATTERNS = [
+    re.compile(r"survey\s+is\s+now\s+complete"),
+    re.compile(r"\b(survey|interview|session)\s+(has\s+been\s+)?(completed|finished|ended)\b"),
+    re.compile(r"thank\s+you[^\n]{0,100}\b(complet|participat|respond|finished|ended)"),
+    re.compile(r"thank\s+you\s+for\s+(taking\s+part|your\s+participation|completing)"),
+    re.compile(r"(your\s+)?(responses?|answers?|submission)\s+(has|have)\s+been\s+(recorded|saved|submitted)"),
+    re.compile(r"\byou\s+have\s+(successfully\s+)?(completed|finished)\b"),
+    re.compile(r"/(complete|completed|finished|thanks|thankyou)\b"),
+    re.compile(r"[?&](end|finished|complete)=?(1|true)?\b"),
+]
+
+VALIDATION_PATTERNS = [
+    re.compile(r"please\s+(answer|enter|select|provide|choose|fill|specify|type|input|check|pick)"),
+    re.compile(r"\bis\s+required\b"),
+    re.compile(r"\brequired\s+(field|answer|question)\b"),
+    re.compile(r"(must|needs?\s+to)\s+be\s+(entered|provided|selected|a\s+(number|valid))"),
+    re.compile(r"\binvalid\s+(value|input|number|entry|format|email|date|response)\b"),
+    re.compile(r"\bselect\s+at\s+least\s+\d+"),
+    re.compile(r"\bchoose\s+at\s+least\s+\d+"),
+    re.compile(r"\bat\s+least\s+\d+\s+(answer|option|selection|item|response|choice)"),
+    re.compile(r"\b(no\s+more\s+than|at\s+most|maximum\s+of|max\.?)\s+\d+"),
+    re.compile(r"\bnumber\s+(must\s+be\s+)?between\b"),
+    re.compile(r"\b(out\s+of\s+range|too\s+(short|long|small|large|high|low))\b"),
+    re.compile(r"\bmust\s+(be\s+)?(a\s+)?(whole\s+)?number\b"),
+    re.compile(r"\b(text\s+is\s+)?too\s+(long|short)\b"),
+    re.compile(r"\b(valid|correct)\s+(email|phone|postcode|zip|format)\b"),
+    re.compile(r"\b(rank|ranking)\s+(everything|all\s+items|each\s+item)\b"),
+    re.compile(r"\bduplicate\s+rank"),
+    re.compile(r"\b(total|sum)\s+(must|should)\s+(be|equal)\b"),
+    re.compile(r"\bmissing\s+(an?\s+)?answer"),
+    re.compile(r"\bno\s+answer\s+(selected|given|provided)\b"),
+    re.compile(r"\b(answer|select|complete)\s+(the\s+)?(following|all|each|this)\s+(question|row|item)"),
+    re.compile(r"\bplease\s+complete\b"),
+]
+
+# class/id hints for error boxes
+ERROR_ELEM_RE = re.compile(r"(error|validation|errormessage|validationmessage|alert)", re.I)
+ERROR_TEXT_RE = re.compile(
+    r"(please\s+(answer|enter|select|provide|choose|fill|specify|type|check)|is\s+required|"
+    r"invalid|at\s+least\s+\d+|too\s+(long|short)|must\s+be|out\s+of\s+range)",
+    re.I,
+)
+
+
+def _search_any(patterns: list[re.Pattern], text: str) -> Optional[re.Match]:
+    for p in patterns:
+        m = p.search(text)
+        if m:
+            return m
+    return None
+
+
+def find_validation(text: str) -> list[str]:
+    """Return validation messages found in `text` (trimmed, deduped)."""
+    out: list[str] = []
+    seen: set[str] = set()
+    for line in text.splitlines():
+        s = line.strip()
+        if not s or len(s) > 300:
+            continue
+        if _search_any(VALIDATION_PATTERNS, s):
+            key = s.lower()
+            if key not in seen:
+                seen.add(key)
+                out.append(s)
+    return out
+
+
+def classify_text(text: str, url: str = "") -> tuple[str, list[str]]:
+    """Classify visible text (plus URL) as an end status.
+
+    Returns (status, [evidence messages]) where status is one of
+    'quota_full' | 'terminate' | 'complete' | '' (not an end page).
+    """
+    low = " ".join(text.lower().split())
+    ulow = url.lower()
+
+    for pat in QUOTA_PATTERNS:
+        m = pat.search(low) or pat.search(ulow)
+        if m:
+            return "quota_full", [_evidence(low, m)]
+
+    for pat in TERMINATE_PATTERNS:
+        m = pat.search(low) or pat.search(ulow)
+        if m:
+            return "terminate", [_evidence(low, m)]
+
+    for pat in COMPLETE_PATTERNS:
+        m = pat.search(low)
+        if m:
+            return "complete", [_evidence(low, m)]
+
+    return "", []
+
+
+def _evidence(low_text: str, m: re.Match) -> str:
+    start = max(0, m.start() - 60)
+    end = min(len(low_text), m.end() + 80)
+    return low_text[start:end].strip(" .;:-")
diff --git a/survey_flow/runner.py b/survey_flow/runner.py
new file mode 100644
index 0000000..89ea633
--- /dev/null
+++ b/survey_flow/runner.py
@@ -0,0 +1,255 @@
+"""The run loop: start a fresh session, walk pages, answer, remember ends,
+until the requested number of completes is reached."""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from dataclasses import dataclass, field
+from typing import Optional
+
+from .analyzer import analyze
+from .decider import Decider
+from .engines import Engine, EngineError, NoSubmitError
+from .memory import TerminateMemory
+from .models import Outcome, Question
+
+log = logging.getLogger("survey_flow.runner")
+
+
+@dataclass
+class RunConfig:
+    url: str
+    completes: int = 1
+    max_attempts: int = 60        # whole runs (sessions)
+    max_pages: int = 80           # pages per run
+    max_same_page: int = 5        # repeats of one page before declaring stuck
+    delay: float = 0.3            # pause between runs
+    trace_path: Optional[str] = "traces.jsonl"
+    consecutive_error_limit: int = 3
+
+
+@dataclass
+class RunResult:
+    status: str                   # complete | terminate | quota_full | stuck | error
+    message: str = ""
+    answers: list = field(default_factory=list)
+    pages: int = 0
+
+
+class Runner:
+    def __init__(
+        self,
+        cfg: RunConfig,
+        memory: TerminateMemory,
+        decider: Decider,
+        engine: Engine,
+    ):
+        self.cfg = cfg
+        self.memory = memory
+        self.decider = decider
+        self.engine = engine
+
+    # ------------------------------------------------------------------ #
+    def run(self) -> int:
+        cfg = self.cfg
+        completes = 0
+        attempts = 0
+        errors = 0
+        t0 = time.time()
+
+        while completes < cfg.completes and attempts < cfg.max_attempts:
+            attempts += 1
+            self.memory.bump("runs")
+            try:
+                result = self._run_once(attempts)
+            except (EngineError, NoSubmitError) as e:
+                errors += 1
+                log.error("attempt %d failed: %s", attempts, e)
+                result = RunResult(status="error", message=str(e))
+                self.memory.bump("stuck")
+            except Exception as e:  # network hiccup, parse bug, ...
+                errors += 1
+                log.error("attempt %d crashed: %s", attempts, e, exc_info=True)
+                result = RunResult(status="error", message=str(e))
+                self.memory.bump("stuck")
+
+            if result.status == "complete":
+                completes += 1
+                errors = 0
+                self.memory.bump("completes")
+                log.info("attempt %d -> COMPLETE (%d/%d) %s",
+                         attempts, completes, cfg.completes, _short(result.answers))
+            elif result.status in ("terminate", "quota_full"):
+                errors = 0
+                verb = "TERMINATE" if result.status == "terminate" else "QUOTA FULL"
+                log.warning("attempt %d -> %s %s %s",
+                            attempts, verb, _short(result.answers),
+                            f"[{result.message}]" if result.message else "")
+            elif result.status == "stuck":
+                log.error("attempt %d -> STUCK %s", attempts, _short(result.answers))
+            else:
+                log.error("attempt %d -> ERROR %s", attempts, result.message)
+
+            self.memory.save()
+            if errors >= cfg.consecutive_error_limit:
+                log.error("aborting after %d consecutive errors", errors)
+                break
+            if completes < cfg.completes and attempts < cfg.max_attempts:
+                if cfg.delay:
+                    time.sleep(cfg.delay)
+
+        elapsed = time.time() - t0
+        self._summary(completes, attempts, elapsed)
+        return 0 if completes >= cfg.completes else 2
+
+    # ------------------------------------------------------------------ #
+    def _run_once(self, attempt_no: int) -> RunResult:
+        cfg = self.cfg
+        session = self.engine.new_session()
+        try:
+            html, url = session.fetch(cfg.url)
+            prev_sig: Optional[str] = None
+            same_count = 0
+            just_submitted = False
+            last_answered: list[tuple[Question, list]] = []
+            unknown_clicks = 0
+            answers: list[str] = []
+            pages = 0
+
+            for _ in range(cfg.max_pages):
+                pages += 1
+                page = analyze(html, url)
+
+                outcome = page.outcome
+                if outcome == Outcome.VALIDATION and not just_submitted:
+                    outcome = Outcome.QUESTION   # stale/first-load message: keep going
+
+                sig = page.signature
+                if sig == prev_sig:
+                    same_count += 1
+                else:
+                    same_count = 0
+                    prev_sig = sig
+
+                # ---------------- end states ---------------- #
+                if outcome in (Outcome.COMPLETE, Outcome.TERMINATE, Outcome.QUOTA_FULL):
+                    status = outcome.value
+                    message = page.messages[0] if page.messages else ""
+                    if status in ("terminate", "quota_full") and last_answered:
+                        self._remember(last_answered, status, url, message)
+                    self._trace(attempt_no, status, message, answers, pages)
+                    return RunResult(status=status, message=message,
+                                     answers=answers, pages=pages)
+
+                # ---------------- interstitial ---------------- #
+                if outcome == Outcome.INTERSTITIAL:
+                    if same_count > cfg.max_same_page:
+                        self._trace(attempt_no, "stuck", "interstitial loop", answers, pages)
+                        return RunResult(status="stuck", message="interstitial loop",
+                                         answers=answers, pages=pages)
+                    html, url = session.submit(page)
+                    just_submitted = True
+                    continue
+
+                # ---------------- unknown ---------------- #
+                if outcome == Outcome.UNKNOWN:
+                    unknown_clicks += 1
+                    if unknown_clicks > 8 or not page.submits:
+                        self._trace(attempt_no, "stuck", "unrecognized page", answers, pages)
+                        return RunResult(status="stuck", message="unrecognized page",
+                                         answers=answers, pages=pages)
+                    html, url = session.submit(page)
+                    just_submitted = True
+                    continue
+
+                # ---------------- question / validation ---------------- #
+                if same_count > cfg.max_same_page:
+                    msg = "; ".join(page.messages[:3])
+                    self._trace(attempt_no, "stuck", msg or "same page repeated",
+                                answers, pages)
+                    if just_submitted:
+                        self.memory.bump("stuck")
+                    return RunResult(status="stuck", message=msg or "same page repeated",
+                                     answers=answers, pages=pages)
+
+                if outcome == Outcome.VALIDATION and just_submitted:
+                    self.memory.bump("validations")
+                    log.info("validation on page %d: %s", pages,
+                             "; ".join(page.messages[:3]))
+
+                vmsgs = page.messages if just_submitted else page.messages
+                self.decider.decide_page(page, attempt=same_count, validation_msgs=vmsgs)
+
+                answered = []
+                for q in page.questions:
+                    entries = _chosen_entries(q)
+                    if entries:
+                        answered.append((q, entries))
+                        label = ", ".join(t for t in q.value_texts)
+                        log.debug("page %d q[%s] -> %s", pages, q.sig, label)
+                if answered:
+                    last_answered = answered
+                    for _q, entries in answered:
+                        answers.append(
+                            f"{_q.sig}=" + "/".join(e["label"] or e["value"] for e in entries)
+                        )
+
+                html, url = session.submit(page)
+                just_submitted = True
+
+            self._trace(attempt_no, "stuck", "max pages reached", answers, pages)
+            self.memory.bump("stuck")
+            return RunResult(status="stuck", message="max pages reached",
+                             answers=answers, pages=pages)
+        finally:
+            session.close()
+
+    # ------------------------------------------------------------------ #
+    def _remember(self, last_answered, status: str, url: str, message: str) -> None:
+        for q, entries in last_answered:
+            recorded = self.memory.mark_end(q.sig, q.text, entries, status, url=url, message=message)
+            if recorded:
+                log.info("memory: %s on %r -> avoid %s", status, q.text[:60],
+                         [e.get("label") or e.get("value") for e in entries])
+
+    def _trace(self, attempt: int, status: str, message: str, answers: list, pages: int) -> None:
+        if not self.cfg.trace_path:
+            return
+        rec = {
+            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
+            "attempt": attempt,
+            "status": status,
+            "message": message[:300],
+            "pages": pages,
+            "answers": answers,
+        }
+        try:
+            with open(self.cfg.trace_path, "a", encoding="utf-8") as fh:
+                fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
+        except OSError:
+            pass
+
+    def _summary(self, completes: int, attempts: int, elapsed: float) -> None:
+        log.info("-" * 60)
+        log.info("finished: %d/%d completes in %d attempts (%.1fs)",
+                 completes, self.cfg.completes, attempts, elapsed)
+        for line in self.memory.summary_lines():
+            log.info("memory: %s", line)
+        if self.memory.path.exists():
+            log.info("memory file: %s", self.memory.path)
+
+
+def _chosen_entries(q: Question) -> list[dict]:
+    out = []
+    for f in q.chosen_options:
+        out.append({"label": f.label, "value": f.value, "identity": f.identity})
+    return out
+
+
+def _short(answers: list) -> str:
+    if not answers:
+        return ""
+    joined = " | ".join(answers[-6:])
+    return ("path: " + joined) if len(joined) <= 200 else ("path: " + joined[:197] + "...")
